{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "1.1.2",
  "description": "DSH Web GUI 的桌面客户端壳",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/icon-gen.js && node scripts/ico-gen.js",
    "render-icon": "electron scripts/render-svg.js",
    "pack": "electron-packager . \"DSH Desktop\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --app-version=1.1.2 --ignore=dist --ignore=release-build --ignore=release",
    "pack:release": "electron-packager . \"DSH Desktop\" --platform=win32 --arch=x64 --out=release-build --overwrite --icon=build/icon.ico --app-version=1.1.2 --ignore=dist --ignore=release-build --ignore=release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-release.ps1"
  },
  "author": "dsh-desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^2.1.8"
  }
}
